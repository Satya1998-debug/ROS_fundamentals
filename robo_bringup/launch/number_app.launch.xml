<launch>
  <node pkg="ros_basics" exec="number_publisher" output="screen" name="my_number_publisher" namespace="/test">
    <remap from="number" to="my_number" />
    <!-- <param name="number" value="6" />
    <param name="timer_period" value="2.0" /> -->
    <param from="$(find-pkg-share robo_bringup)/config/number.yaml" />
  </node>
  <node pkg="ros_basics" exec="number_counter" output="screen" name="my_number_counter" namespace="/test">
    <remap from="number" to="my_number" />
  </node>
</launch>