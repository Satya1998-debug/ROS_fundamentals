<launch>
    <!-- creating a variable for storing path of the urdf file path, the urdf is in the share folder-->
    <let name="urdf_path" value="$(find-pkg-share robot_description)/urdf/my_robot.urdf.xacro"/>
    <let name="rviz_config_path" value="$(find-pkg-share robot_description)/rviz/urdf_config.rviz"/>

    <!-- The xacro takes the urdf file and generates a URDF for the robot_description topic where, it contains the actual values of all variables-->
    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
    </node>

    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" />

    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_config_path)" output="screen" />

</launch>