<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.6"/>
    <xacro:property name="base_width" value="0.4"/>
    <xacro:property name="base_height" value="0.2"/>
    <xacro:property name="wheel_radius" value="0.1"/>
    <xacro:property name="wheel_width" value="0.05"/>
    <xacro:property name="mid_body_lenth" value="0.2"/>
    <xacro:property name="mid_body_radius" value="0.1"/>
    <xacro:property name="top_lenth" value="0.1"/>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
            <material name="green"/>
        </visual>
    </link>

    <link name="second_link">
        <visual>
            <geometry>
                <cylinder radius="${mid_body_radius}" length="${mid_body_lenth}"/>
            </geometry>
            <origin xyz="0 0 ${mid_body_lenth/2.0}" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
    </link>

    <link name="third_link">
        <visual>
            <geometry>
                <box size="${top_lenth} ${top_lenth} ${top_lenth}"/>
            </geometry>
            <origin xyz="0 0 ${top_lenth/2.0}" rpy="0 0 0"/>
        </visual>
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
                <material name="grey"/>
            </visual>
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right"/>
    <xacro:wheel_link prefix="left"/>

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius/2.0}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
    </link>

    <link name="base_footprint"/>

    <joint name="base_second_joint" type="revolute">
        <parent link="base_link"/>
        <child link="second_link"/>
        <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="${-pi/2.0}" upper="${pi/2.0}" velocity="100" effort="100"/>
    </joint>

    <joint name="second_third_joint" type="revolute">
        <parent link="second_link"/>
        <child link="third_link"/>
        <origin xyz="0 0 ${mid_body_lenth}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="${-pi/2.0}" upper="${pi/2.0}" velocity="100" effort="100"/>
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="${-base_length/4.0} ${-(base_width + wheel_width)/2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="${-base_length/4.0} ${(base_width + wheel_width)/2.0} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="${base_length/3.0} 0 ${-wheel_radius/2.0}" rpy="0 0 0"/>
        <axis xyz="0 0 0"/>
    </joint>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

</robot>